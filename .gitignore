/target
/dist
# The vendored library keeps its own target and lock: the proxy's lock pins
# the crates, and a second lock here would be a second answer to pin.
vendor/logreel/target/
# The tools' workspace has its own target too.
tools/log-tools/target/
vendor/logreel/Cargo.lock
/openwrt/files/tg-ws-proxy
.DS_Store

# Android
android/.gradle/
android/build/
android/app/build/
android/build-logic/build/
android/build-logic/.gradle/
android/build-logic/.kotlin/
android/local.properties
android/.idea/
android/.kotlin/
android/keystore.properties
# Signing keys never belong in the tree: an Android release key is permanent —
# lose it and no existing install can ever be updated again, publish it and
# anyone can ship an update users' phones will accept.
*.jks
*.keystore
*.iml
android/captures/
